CATALOG_V2_SERVICE_TOKEN=
CATALOG_AGENT_BASE_URL=http://litellm:4000
CATALOG_AGENT_API_KEY=
CATALOG_AGENT_MODEL=trial-parser
BAILIAN_API_KEY=
BAILIAN_BASE_URL=
# Used only when the primary vision model repeatedly returns HTTP 200 with empty text.
BAILIAN_VISION_FALLBACK_MODEL=qwen-vl-max
# Conservative cosine threshold for suggesting a catalog item from a customer photo.
BAILIAN_MM_MIN_SCORE=0.45
# External HTTPS address of the sidecar (used in customer and merchant links)
CATALOG_V2_PUBLIC_URL=
# Optional per-instance identity guard used by the WeChat merchant plugin.
# Must match shop_profile.shop_id for this independent deployment.
# CATALOG_EXPECTED_SHOP_ID=
TG_BOT_TOKEN=
CATALOG_NOTIFY_URL=http://127.0.0.1:17606/notify
CATALOG_NOTIFY_TOKEN=
# Optional absolute paths; keep persistent data outside release directories.
# CATALOG_V2_DB=/srv/dangkou-data/catalog.db
# CATALOG_V2_IMG=/srv/dangkou-data/images
# CATALOG_CS_PHOTOS=/srv/dangkou-data/cs_photos

# Build deploy/Dockerfile.agent with an approved CLI version, then set this image.
CATALOG_AGENT_CONTAINER_IMAGE=
# Outbound delivery runs only in scripts/run_notifications.py (all notify* channels);
# there is no partition switch anymore.
# Real TG tests require an explicitly authorized test chat and RUN_REAL_TG=1.
# TG_TEST_CHAT_ID=

# Optional: Telegram-only outbound proxy, e.g. socks5h://127.0.0.1:17891
TG_PROXY_URL=


# Merchant onboarding: enable only on the central API, never tenant APIs.
MERCHANT_HUB_ENABLED=0
# ONBOARDING_PUBLIC_URL=https://your-public-host
# MERCHANT_HUB_DB=/home/ubuntu/dangkou-v2/data/merchant-hub.db
# MERCHANT_RUNTIME_DIR=/home/ubuntu/dangkou-v2/data/merchants
MERCHANT_MAX_ACCOUNTS=100
MERCHANT_MAX_ACTIVE=5
# Set to previous platform bot MAX(update_id)+1 on first cutover.
MERCHANT_HUB_INITIAL_OFFSET=0
# Never enable ONBOARDING_ALLOW_HTTP_TEST in production.
# WeChat merchant QR binding (admin stays localhost; token is never exposed to H5)
WECHAT_BINDING_FILE=
WECHAT_BINDING_ADMIN_URL=http://127.0.0.1:17605
WECHAT_BINDING_ADMIN_TOKEN_FILE=

# NEW isolated trial sample. Required persistent paths: customize before deployment.
CATALOG_V2_DB=/home/ubuntu/dangkou-wechat-test/data/catalog.db
CATALOG_V2_IMG=/home/ubuntu/dangkou-wechat-test/data/images
CATALOG_CS_PHOTOS=/home/ubuntu/dangkou-wechat-test/data/cs_photos
USER_APP_DB=/home/ubuntu/dangkou-wechat-test/data/userapp.db
USER_APP_PHOTOS=/home/ubuntu/dangkou-wechat-test/data/userapp_photos
USER_APP_PORT=19100
CUSTOMER_IDENTITY_BASE_URL=http://127.0.0.1:19100
USER_APP_ENV=production
RESEND_API_KEY=
RESEND_FROM=
# Explicit development-only code log, NEVER enable in production.
USER_APP_DEV_EMAIL_LOG=0
USER_APP_CODES_LOG=/home/ubuntu/dangkou-wechat-test/data/userapp-codes.log
USER_APP_OTP_TTL_SECONDS=600
USER_APP_OTP_COOLDOWN_SECONDS=60
USER_APP_OTP_MAX_ATTEMPTS=5
GUEST_IDLE_SECONDS=86400
CATALOG_UPLOAD_MAX_BYTES=20971520
CATALOG_UPLOAD_MAX_PIXELS=40000000
CATALOG_IMPORT_MAX_BYTES=209715200
CATALOG_IMPORT_UNPACKED_BYTES=786432000
# Host-wide actual-work admission shared by API/notifications and ALL tenants.
# Same absolute directory for every service user/process; persistent, private, writable.
CATALOG_PARSER_STATE_DIR=/home/ubuntu/dangkou-parser-state
# A queued document has attempt=0; default one actual parser on this host.
CATALOG_IMPORT_WORKERS=1
CATALOG_AGENT_TIMEOUT=2700
# Dedicated named network; parser sees litellm:4000, host sees 127.0.0.1:4000.
CATALOG_AGENT_NETWORK=dangkou-trial-parser
LITELLM_MASTER_KEY=
# Explicit authorized provider model, region/base and credential. No fallback provider.
LITELLM_UPSTREAM_MODEL=
LITELLM_UPSTREAM_BASE_URL=
LITELLM_UPSTREAM_API_KEY=
