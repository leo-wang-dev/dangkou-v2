[Unit]
Description=Dangkou isolated merchant customer workers
Wants=network-online.target dangkou-vpn.service
After=network-online.target dangkou-vpn.service
[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/dangkou-v2
EnvironmentFile=/home/ubuntu/dangkou-v2/.env
EnvironmentFile=/home/ubuntu/dangkou-v2/.env.merchant-hub
ExecStart=/home/ubuntu/dangkou-v2/.venv-unified/bin/python -u scripts/run_merchant_runtime.py
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
