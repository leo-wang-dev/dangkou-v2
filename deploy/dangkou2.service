[Unit]
Description=Dangkou shared merchant and customer API
Wants=network-online.target
After=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/dangkou-v2
EnvironmentFile=/home/ubuntu/dangkou-v2/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/ubuntu/dangkou-v2/.venv-unified/bin/python -m uvicorn catalog.main:app --host 0.0.0.0 --port 8890 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
