# Build using an explicitly selected CLI version; this image never includes merchant secrets.
FROM node:22-bookworm-slim
ARG CLAUDE_CODE_VERSION
RUN test -n "$CLAUDE_CODE_VERSION" \
    && apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/parser-python \
    && /opt/parser-python/bin/pip install --no-cache-dir openpyxl==3.1.5 pillow==11.3.0 \
    && npm install -g "@anthropic-ai/claude-code@$CLAUDE_CODE_VERSION"
ENV PATH="/opt/parser-python/bin:$PATH"
WORKDIR /work
ENTRYPOINT ["claude"]
